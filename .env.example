# ─────────────────────────────────────────────────────────────
#  Настройки проекта «AI-ассистент по новостройкам»
#  Скопируйте этот файл в .env и при необходимости поправьте значения:
#      cp .env.example .env
#  Для запуска через Docker менять здесь ничего не обязательно —
#  всё работает со значениями по умолчанию.
# ─────────────────────────────────────────────────────────────

# ── База данных ──────────────────────────────────────────────

# Адрес подключения к PostgreSQL.
# Для запуска БЕЗ Docker (npm run dev) — база на вашем компьютере,
# порт 5433 (его же публикует docker compose up -d postgres).
DATABASE_URL=postgresql://novostroyki:novostroyki@localhost:5433/novostroyki?schema=public

# Отдельная база, на которой гоняются автотесты. Её содержимое
# затирается между тестами, ничего ценного там держать нельзя.
TEST_DATABASE_URL=postgresql://novostroyki:novostroyki@localhost:5434/novostroyki_test?schema=public

# ── Сервер ───────────────────────────────────────────────────

# Порт, на котором приложение слушает запросы внутри контейнера.
PORT=3000

# Сетевой интерфейс. 0.0.0.0 — принимать запросы отовсюду.
HOST=0.0.0.0

# Режим работы: development (подробные логи) или production.
NODE_ENV=development

# Насколько подробно писать в лог: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

# Адрес, по которому сайт доступен снаружи. Используется в строчке
# установки виджета, которую админка показывает для копирования.
PUBLIC_BASE_URL=http://localhost:3000

# ── Вход в админку ───────────────────────────────────────────

# Логин и пароль администратора. Обязательно поменяйте перед тем,
# как выкладывать проект на сервер.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Секретная строка, которой подписывается кука сессии.
# На сервере замените на длинную случайную последовательность.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Модель Anthropic ─────────────────────────────────────────

# Ключ доступа к Claude. Обычно вставляется через админку и хранится
# в базе; эта переменная — запасной вариант. Можно оставить пустой:
# приложение поднимется, чат честно скажет, что ключ не задан.
ANTHROPIC_API_KEY=

# ── Порты на вашем компьютере (только для docker compose) ────

# На каком порту открывать приложение в браузере.
APP_PORT=3000

# На каком порту доступна основная база данных.
POSTGRES_PORT=5433

# На каком порту доступна тестовая база данных.
POSTGRES_TEST_PORT=5434
