# nginx.conf.template — example of minimal HTTP/3-capable server block
# Replace server_name and TLS certificates with your production values.

worker_processes  1;

events {
  worker_connections  1024;
}

http {
  include       mime.types;
  default_type  application/octet-stream;

  sendfile        on;
  keepalive_timeout  65;

  server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
  }

  server {
    # Listen for TLS (HTTP/2) over TCP
    listen 443 ssl http2;

    # Listen for QUIC/HTTP3 over UDP (requires nginx built with quic/http_v3)
    listen 443 quic reuseport;

    server_name example.com;

    ssl_certificate /etc/ssl/certs/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/privkey.pem;

    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Optional: tune ciphers for modern TLS 1.3
    ssl_ciphers TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256;

    # Inform clients that HTTP/3 is available
    add_header Alt-Svc 'h3=":443"';
    add_header QUIC-Status $quic;

    root /usr/share/nginx/html;

    location / {
      try_files $uri $uri/ =404;
    }
  }
}
