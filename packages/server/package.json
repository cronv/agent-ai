{
  "name": "@novostroyki/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:studio": "tsx src/scripts/prisma.ts studio",
    "migrate:dev": "tsx src/scripts/prisma.ts migrate dev",
    "migrate:deploy": "tsx src/scripts/prisma.ts migrate deploy",
    "migrate:reset": "tsx src/scripts/prisma.ts migrate reset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@prisma/client": "^6.16.2",
    "dotenv": "^17.2.1",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "mammoth": "^1.12.0",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.16.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
